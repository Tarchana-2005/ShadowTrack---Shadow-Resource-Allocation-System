 "font_size": 14,
 "html": "<!-- Assignment Summary Print Format -->\n<style>\n    .pf-wrapper {\n        font-family: Arial, sans-serif;\n        font-size: 13px;\n        color: #333;\n        padding: 20px;\n    }\n\n    .pf-header {\n        text-align: center;\n        margin-bottom: 30px;\n        border-bottom: 2px solid #333;\n        padding-bottom: 15px;\n    }\n\n    .pf-header h2 {\n        margin: 0;\n        font-size: 22px;\n        font-weight: bold;\n        color: #1a1a2e;\n    }\n\n    .pf-header p {\n        margin: 5px 0 0;\n        font-size: 13px;\n        color: #666;\n    }\n\n    .pf-badge {\n        display: inline-block;\n        padding: 4px 14px;\n        border-radius: 20px;\n        font-size: 12px;\n        font-weight: bold;\n        background: #e8f5e9;\n        color: #2e7d32;\n        margin-top: 8px;\n    }\n\n    .pf-section {\n        margin-bottom: 25px;\n    }\n\n    .pf-section-title {\n        font-size: 13px;\n        font-weight: bold;\n        text-transform: uppercase;\n        letter-spacing: 1px;\n        color: #fff;\n        background: #1a1a2e;\n        padding: 6px 12px;\n        margin-bottom: 12px;\n        border-radius: 4px;\n    }\n\n    .pf-label {\n        font-size: 11px;\n        color: #888;\n        text-transform: uppercase;\n        letter-spacing: 0.5px;\n        margin-bottom: 2px;\n    }\n\n    .pf-value {\n        font-size: 13px;\n        font-weight: 600;\n        color: #1a1a2e;\n    }\n\n    .pf-table {\n        width: 100%;\n        border-collapse: collapse;\n        font-size: 12px;\n        margin-top: 5px;\n    }\n\n    .pf-table th {\n        background: #f0f0f0;\n        padding: 8px 10px;\n        text-align: left;\n        font-weight: bold;\n        border: 1px solid #ddd;\n        color: #444;\n    }\n\n    .pf-table td {\n        padding: 7px 10px;\n        border: 1px solid #ddd;\n        vertical-align: top;\n        color: #333;\n    }\n\n    .pf-table tr:nth-child(even) {\n        background: #fafafa;\n    }\n\n    .no-data {\n        color: #aaa;\n        font-style: italic;\n        font-size: 12px;\n        padding: 10px 0;\n    }\n</style>\n\n<div class=\"pf-wrapper\">\n\n    <!-- \u2550\u2550 HEADER \u2550\u2550 -->\n    <div class=\"pf-header\">\n        <h2>Shadow Assignment Summary</h2>\n        <p>{{ doc.name }}</p>\n        <span class=\"pf-badge\">{{ doc.workflow_state }}</span>\n    </div>\n\n    <!-- \u2550\u2550 SECTION 1: EMPLOYEE DETAILS \u2550\u2550 -->\n    <div class=\"pf-section\">\n        <div class=\"pf-section-title\">Employee Details</div>\n        <table style=\"width:100%; border-collapse:collapse;\">\n            <tr>\n                <td style=\"width:50%; padding:6px 0;\">\n                    <div class=\"pf-label\">Employee</div>\n                    <div class=\"pf-value\">{{ doc.employee }}</div>\n                </td>\n                <td style=\"width:50%; padding:6px 0;\">\n                    <div class=\"pf-label\">Project</div>\n                    <div class=\"pf-value\">{{ doc.project }}</div>\n                </td>\n            </tr>\n            <tr>\n                <td style=\"padding:6px 0;\">\n                    <div class=\"pf-label\">Mentor</div>\n                    <div class=\"pf-value\">{{ doc.mentor }}</div>\n                </td>\n                <td style=\"padding:6px 0;\">\n                    <div class=\"pf-label\">Manager</div>\n                    <div class=\"pf-value\">{{ doc.manager }}</div>\n                </td>\n            </tr>\n            <tr>\n                <td style=\"padding:6px 0;\">\n                    <div class=\"pf-label\">Final Decision</div>\n                    <div class=\"pf-value\">{{ doc.final_decision or \"Pending\" }}</div>\n                </td>\n                <td style=\"padding:6px 0;\">\n                    <div class=\"pf-label\">Evaluation Score</div>\n                    <div class=\"pf-value\">{{ doc.evaluation_score or \"N/A\" }}</div>\n                </td>\n            </tr>\n        </table>\n    </div>\n\n    <!-- \u2550\u2550 SECTION 2: TRAINING DURATION \u2550\u2550 -->\n    <div class=\"pf-section\">\n        <div class=\"pf-section-title\">Training Duration</div>\n        <table style=\"width:100%; border-collapse:collapse;\">\n            <tr>\n                <td style=\"width:50%; padding:6px 0;\">\n                    <div class=\"pf-label\">Start Date</div>\n                    <div class=\"pf-value\">{{ doc.start_date }}</div>\n                </td>\n                <td style=\"width:50%; padding:6px 0;\">\n                    <div class=\"pf-label\">End Date</div>\n                    <div class=\"pf-value\">{{ doc.end_date }}</div>\n                </td>\n            </tr>\n            <tr>\n                <td style=\"padding:6px 0;\">\n                    <div class=\"pf-label\">Duration</div>\n                    <div class=\"pf-value\">\n                        {% if doc.start_date and doc.end_date %}\n                            {{ frappe.utils.date_diff(doc.end_date, doc.start_date) }} Days\n                        {% else %}\n                            N/A\n                        {% endif %}\n                    </div>\n                </td>\n                <td style=\"padding:6px 0;\">\n                    <div class=\"pf-label\">Status</div>\n                    <div class=\"pf-value\">{{ doc.status }}</div>\n                </td>\n            </tr>\n            {% if doc.extension_reason %}\n            <tr>\n                <td colspan=\"2\" style=\"padding:6px 0;\">\n                    <div class=\"pf-label\">Reason for Extension</div>\n                    <div class=\"pf-value\">{{ doc.extension_reason }}</div>\n                </td>\n            </tr>\n            {% endif %}\n        </table>\n    </div>\n\n    <!-- \u2550\u2550 SECTION 3: LEARNING LOGS \u2550\u2550 -->\n    <div class=\"pf-section\">\n        <div class=\"pf-section-title\">Learning Logs Summary</div>\n        {% if doc.learning_log %}\n        <table class=\"pf-table\">\n            <thead>\n                <tr>\n                    <th style=\"width:90px;\">Date</th>\n                    <th>Task Detail</th>\n                    <th>Task Observed</th>\n                    <th>Task Performed</th>\n                    <th>Feedback</th>\n                </tr>\n            </thead>\n            <tbody>\n                {% for log in doc.learning_log %}\n                <tr>\n                    <td>{{ log.date }}</td>\n                    <td>{{ log.task_detail or \"-\" }}</td>\n                    <td>{{ log.task_observed or \"-\" }}</td>\n                    <td>{{ log.task_performed or \"-\" }}</td>\n                    <td>{{ log.feedback or \"-\" }}</td>\n                </tr>\n                {% endfor %}\n            </tbody>\n        </table>\n        {% else %}\n        <p class=\"no-data\">No learning logs recorded yet.</p>\n        {% endif %}\n    </div>\n\n    <!-- \u2550\u2550 SECTION 4: EVALUATION SUMMARY \u2550\u2550 -->\n    <div class=\"pf-section\">\n        <div class=\"pf-section-title\">Evaluation Summary</div>\n        {% if doc.evaluation_log %}\n            {% for eval in doc.evaluation_log %}\n\n            <!-- Score Cards as Table -->\n            <table style=\"width:100%; border-collapse:collapse; margin-bottom:15px;\">\n                <tr>\n                    <td style=\"width:33%; text-align:center; background:#f5f5f5; border:1px solid #e0e0e0; border-radius:6px; padding:10px;\">\n                        <div style=\"font-size:11px; color:#888; text-transform:uppercase;\">Technical Skills</div>\n                        <div style=\"font-size:22px; font-weight:bold; color:#1a1a2e;\">{{ eval.technical_skills or 0 }}</div>\n                    </td>\n                    <td style=\"width:5%;\"></td>\n                    <td style=\"width:33%; text-align:center; background:#f5f5f5; border:1px solid #e0e0e0; border-radius:6px; padding:10px;\">\n                        <div style=\"font-size:11px; color:#888; text-transform:uppercase;\">Communication</div>\n                        <div style=\"font-size:22px; font-weight:bold; color:#1a1a2e;\">{{ eval.communication or 0 }}</div>\n                    </td>\n                    <td style=\"width:5%;\"></td>\n                    <td style=\"width:33%; text-align:center; background:#f5f5f5; border:1px solid #e0e0e0; border-radius:6px; padding:10px;\">\n                        <div style=\"font-size:11px; color:#888; text-transform:uppercase;\">Task Handling</div>\n                        <div style=\"font-size:22px; font-weight:bold; color:#1a1a2e;\">{{ eval.task_handling or 0 }}</div>\n                    </td>\n                </tr>\n            </table>\n\n            <!-- Recommendation and Date -->\n            <table style=\"width:100%; border-collapse:collapse;\">\n                <tr>\n                    <td style=\"width:50%; padding:6px 0;\">\n                        <div class=\"pf-label\">Mentor Recommendation</div>\n                        <div class=\"pf-value\">{{ eval.mentor_recommendation or \"Pending\" }}</div>\n                    </td>\n                    <td style=\"width:50%; padding:6px 0;\">\n                        <div class=\"pf-label\">Evaluation Date</div>\n                        <div class=\"pf-value\">{{ eval.evaluation_date or \"N/A\" }}</div>\n                    </td>\n                </tr>\n            </table>\n\n            {% endfor %}\n        {% else %}\n            <p class=\"no-data\">No evaluation submitted yet.</p>\n        {% endif %}\n    </div>\n\n    <!-- \u2550\u2550 FOOTER: SIGNATURES \u2550\u2550 -->\n    <table style=\"width:100%; margin-top:40px; border-top:1px solid #ddd;\">\n        <tr>\n            <td style=\"width:33%; text-align:center; padding-top:20px;\">\n                <div style=\"border-top:1px solid #333; margin-bottom:6px;\"></div>\n                <span style=\"font-size:11px; color:#666;\">Employee Signature</span>\n            </td>\n            <td style=\"width:33%; text-align:center; padding-top:20px;\">\n                <div style=\"border-top:1px solid #333; margin-bottom:6px;\"></div>\n                <span style=\"font-size:11px; color:#666;\">Mentor Signature</span>\n            </td>\n            <td style=\"width:33%; text-align:center; padding-top:20px;\">\n                <div style=\"border-top:1px solid #333; margin-bottom:6px;\"></div>\n                <span style=\"font-size:11px; color:#666;\">Manager Signature</span>\n            </td>\n        </tr>\n    </table>\n\n</div>",
